# This is a compiler wrapper around clang++ for building a project which uses Kokkos with the Cuda backend enabled, due to issues with nvcc and the nvcc_wrapper provided by Kokkos.
#
# When relevant, this wrapper should be used as the CXX_COMPILER or OMPI_CXX backend in combination with CMake flags to signal which targets (or objects) should be compiled for CUDA device (CLANGCUDA_MODE_DEVICE), CUDA host-only (CLANGCUDA_MODE_HOST), or normal (non-CUDA) C++.
#
# The following environment variables can be used to override the defaults:
# - CLANGCUDA_CLANG_PATH: path to clang++
# - CLANGCUDA_CUDA_PATH: path to the CUDA toolkit
# - CLANGCUDA_ARCH: GPU architecture (detected from Kokkos by default) (e.g. sm_90)
# - CLANGCUDA_LOG: optional path to a log file for recording final commands

clang_path="${CLANGCUDA_CLANG_PATH:-/bin/clang++}"
cuda_path="${CLANGCUDA_CUDA_PATH:-${CUDA_HOME:-/usr/local/cuda}}"

compile=0
mode_cuda_host=0
mode_cuda_device=0
arch="${CLANGCUDA_ARCH:-}"

args=()
skip_next_x=0

for arg in "$@"; do
  if [[ "$skip_next_x" == "1" ]]; then
    skip_next_x=0
    continue
  fi

  case "$arg" in
    -c)
      compile=1
      args+=("$arg")
      ;;

    -DCLANGCUDA_MODE_HOST)
      mode_cuda_host=1
      args+=("$arg")
      ;;

    -DCLANGCUDA_MODE_DEVICE)
      mode_cuda_device=1
      args+=("$arg")
      ;;

    -extended-lambda|--extended-lambda|--expt-extended-lambda|-expt-extended-lambda)
      ;;

    -expt-relaxed-constexpr|--expt-relaxed-constexpr)
      ;;

    -Wext-lambda-captures-this)
      ;;

    -arch=sm_*|--cuda-gpu-arch=sm_*)
      # Reuse the architecture supplied by Kokkos unless the user explicitly overrides it.
      if [[ -z "$arch" ]]; then
        arch="${arg#*=}"
      fi
      ;;

    -ccbin=*|--compiler-bindir=*)
      ;;

    -x)
      # Drop incoming language override and the following language token.
      skip_next_x=1
      ;;

    *)
      args+=("$arg")
      ;;
  esac
done

# Host-only and device compilation are mutually exclusive.
if [[ "$mode_cuda_host" == "1" && "$mode_cuda_device" == "1" ]]; then
  echo "clangcuda++ wrapper error: both CLANGCUDA_MODE_HOST and CLANGCUDA_MODE_DEVICE were set" >&2
  exit 1
fi

final=("$clang_path")
if [[ "$compile" == "1" && ( "$mode_cuda_host" == "1" || "$mode_cuda_device" == "1" ) ]]; then
  if [[ -z "$arch" ]]; then
    echo "clangcuda++ wrapper error: no CUDA architecture specified or supplied by Kokkos; please specify the architecture with CLANGCUDA_ARCH (e.g. export CLANGCUDA_ARCH=sm_90)" >&2
    exit 1
  fi

  final+=(-x cuda)
  if [[ "$mode_cuda_host" == "1" ]]; then
    final+=(--cuda-host-only)
  fi
  final+=(
    --cuda-path="$cuda_path"
    --cuda-gpu-arch="$arch"
  )
  compatibility_dir="${BASH_SOURCE[0]%/*}/clangcuda-compat"
  cuda_include_dirs=(
    "$cuda_path/include"
    "$cuda_path/targets/$(uname -m)-linux/include"
  )

  cuda_version_header=""
  for include_dir in "${cuda_include_dirs[@]}"; do
    if [[ -f "$include_dir/cuda.h" ]]; then
      cuda_version_header="$include_dir/cuda.h"
      break
    fi
  done
  if [[ -z "$cuda_version_header" ]]; then
    echo "clangcuda++ wrapper error: could not find cuda.h under $cuda_path" >&2
    exit 1
  fi

  cuda_version="$(awk '$1 == "#define" && $2 == "CUDA_VERSION" { print $3; exit }' "$cuda_version_header")"
  if [[ ! "$cuda_version" =~ ^[0-9]+$ ]]; then
    echo "clangcuda++ wrapper error: could not determine CUDA_VERSION from $cuda_version_header" >&2
    exit 1
  fi
  if ((cuda_version >= 13000)); then
    final+=(-I"$compatibility_dir")
  fi

  for include_dir in "${cuda_include_dirs[@]}"; do
    math_functions_header="$include_dir/crt/math_functions.hpp"
    if [[ -f "$math_functions_header" ]] &&
      grep -q 'rsqrt(const double a)) _NV_RSQRT_SPECIFIER' "$math_functions_header"; then
      final+=('-D_NV_RSQRT_SPECIFIER=noexcept(true)')
      break
    fi
  done
fi
final+=(-Wno-unknown-cuda-version "${args[@]}")

# Only compilation needs a launcher; link commands skip its setup and validation entirely.
if [[ "$compile" == "1" ]]; then
  # Reconstruct the launcher (e.g. ccache) after preparing the final Clang arguments.
  # Numbered environment variables preserve spaces and argument boundaries through wrappers.
  compiler_launcher=()
  if [[ -n "${CLANGCUDA_COMPILER_LAUNCHER_ARG_COUNT:-}" ]]; then
    if [[ ! "$CLANGCUDA_COMPILER_LAUNCHER_ARG_COUNT" =~ ^[0-9]+$ ]]; then
      echo "clangcuda++ wrapper error: invalid compiler launcher argument count" >&2
      exit 1
    fi

    # Interpret the count as decimal, including values with leading zeros.
    for ((i = 0; i < 10#$CLANGCUDA_COMPILER_LAUNCHER_ARG_COUNT; ++i)); do
      compiler_launcher_arg_variable="CLANGCUDA_COMPILER_LAUNCHER_ARG_${i}"
      if ! declare -p "$compiler_launcher_arg_variable" &>/dev/null; then
        echo "clangcuda++ wrapper error: missing compiler launcher argument ${i}" >&2
        exit 1
      fi
      compiler_launcher+=("${!compiler_launcher_arg_variable}")
    done
  elif [[ -n "${CLANGCUDA_COMPILER_LAUNCHER:-}" ]]; then
    # Alternatively, accept a single launcher executable without numbered argument variables.
    compiler_launcher+=("$CLANGCUDA_COMPILER_LAUNCHER")
  fi

  # An empty launcher array leaves the command unchanged.
  final=("${compiler_launcher[@]}" "${final[@]}")
fi

# CUDA's fatbinary CLI changed with the toolkit. Keep Clang pointed at this
# compatibility wrapper, which forwards directly or translates as needed.
if [[ "$compile" == "1" && ( "$mode_cuda_host" == "1" || "$mode_cuda_device" == "1" ) ]]; then
  export CLANGCUDA_CUDA_PATH="$cuda_path"
  final+=(-B"${BASH_SOURCE[0]%/*}/clangcuda-compat/bin")
fi

if [[ -n "$CLANGCUDA_LOG" ]]; then
  printf '%q ' "${final[@]}" >> "$CLANGCUDA_LOG"
  printf '\n' >> "$CLANGCUDA_LOG"
fi

exec "${final[@]}"
